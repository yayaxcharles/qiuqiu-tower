{
 "你們師父？呵，上面那位灌的可不是酒，是魔氣。喝了就再也想不起自己是誰。": {
  "zh": "你們師父？呵，上面那位灌的可不是酒，是魔氣。喝了就再也想不起自己是誰。",
  "speaker": "塔主"
 },
 "想不起自己是誰……那我們就一直叫他的名字，叫到他想起來。": {
  "zh": "想不起自己是誰……那我們就一直叫他的名字，叫到他想起來。",
  "speaker": "菲菲"
 },
 "呵呵……老夫本想騙你們兩個一杯酒的。": {
  "zh": "呵呵……老夫本想騙你們兩個一杯酒的。",
  "speaker": "塔主"
 },
 "上面那位喝的不是酒，是魔氣。喝了就想不起自己是誰。你們上去，可要記得叫醒他。": {
  "zh": "上面那位喝的不是酒，是魔氣。喝了就想不起自己是誰。你們上去，可要記得叫醒他。",
  "speaker": "塔主"
 },
 "我會叫到他醒喵！": {
  "zh": "我會叫到他醒喵！",
  "speaker": "球球"
 },
 "我、我也會叫。……師兄叫累了，就換我。": {
  "zh": "我、我也會叫。……師兄叫累了，就換我。",
  "speaker": "菲菲"
 },
 "想不起來，我們就一件一件講給他聽。": {
  "zh": "想不起來，我們就一件一件講給他聽。",
  "speaker": "噹噹"
 },
 "叫不醒，我就把門敲到他醒。": {
  "zh": "叫不醒，我就把門敲到他醒。",
  "speaker": "噹噹"
 },
 "想不起自己是誰，也還記得回家的路。我們帶他走一遍。": {
  "zh": "想不起自己是誰，也還記得回家的路。我們帶他走一遍。",
  "speaker": "封封"
 },
 "我們一左一右喊，他轉頭就看得到。": {
  "zh": "我們一左一右喊，他轉頭就看得到。",
  "speaker": "封封"
 },
 "那就別讓他再喝。先把你這壺打翻。": {
  "zh": "那就別讓他再喝。先把你這壺打翻。",
  "speaker": "噹噹"
 },
 "叫醒……嗯，我會記得。": {
  "zh": "叫醒……嗯，我會記得。",
  "speaker": "菲菲"
 },
 "兩個一起叫，聲音比較大。": {
  "zh": "兩個一起叫，聲音比較大。",
  "speaker": "噹噹"
 },
 "那這壺酒，我們替他倒掉。": {
  "zh": "那這壺酒，我們替他倒掉。",
  "speaker": "封封"
 },
 "嗯，我會叫他。……這次要叫得比那晚還大聲。": {
  "zh": "嗯，我會叫他。……這次要叫得比那晚還大聲。",
  "speaker": "菲菲"
 },
 "我在旁邊替你擋著，你只管叫。": {
  "zh": "我在旁邊替你擋著，你只管叫。",
  "speaker": "封封"
 },
 "想不起來，我們就替他記著回村的路。": {
  "zh": "想不起來，我們就替他記著回村的路。",
  "speaker": "封封"
 },
 "記得。": {
  "zh": "記得。",
  "speaker": "噹噹"
 },
 "球球和菲菲的聲音，他一定認得。我們先把他們找到。": {
  "zh": "球球和菲菲的聲音，他一定認得。我們先把他們找到。",
  "speaker": "封封"
 },
 "紫霧散盡的地方，那個影子抱著舊木劍走了出來。它把劍放在師父腳邊，朝球球點點頭，就滑回了他的腳下。": {
  "zh": "紫霧散盡的地方，那個影子抱著舊木劍走了出來。它把劍放在師父腳邊，朝球球點點頭，就滑回了他的腳下。",
  "speaker": "(unknown / narration or enemy)"
 },
 "紫霧散開，那個影子抱著舊木劍站在師父身後。它把劍放下，碰了碰菲菲的手腕，就滑回她的腳下。": {
  "zh": "紫霧散開，那個影子抱著舊木劍站在師父身後。它把劍放下，碰了碰菲菲的手腕，就滑回她的腳下。",
  "speaker": "(unknown / narration or enemy)"
 },
 "紫霧散開，那個影子抱著舊木劍守在門邊。它把劍靠在大俠貓腳旁，就滑回噹噹腳下，像換班一樣。": {
  "zh": "紫霧散開，那個影子抱著舊木劍守在門邊。它把劍靠在大俠貓腳旁，就滑回噹噹腳下，像換班一樣。",
  "speaker": "(unknown / narration or enemy)"
 },
 "紫霧散開，那個影子抱著舊木劍站在最高那一階。它把劍交給大俠貓，側身一讓，滑回了封封腳下。": {
  "zh": "紫霧散開，那個影子抱著舊木劍站在最高那一階。它把劍交給大俠貓，側身一讓，滑回了封封腳下。",
  "speaker": "(unknown / narration or enemy)"
 },
 "最上層的石階上，那把舊木劍還躺在原地。{名}撿起來交給{師}，腳下的影子也跟著彎了彎腰。": {
  "zh": "最上層的石階上，那把舊木劍還躺在原地。{名}撿起來交給{師}，腳下的影子也跟著彎了彎腰。",
  "speaker": "(unknown / narration or enemy)"
 },
 "球球雙手捧出那把舊木劍。師父接過去，用劍背在他頭上輕輕敲了一下，跟以前一模一樣。": {
  "zh": "球球雙手捧出那把舊木劍。師父接過去，用劍背在他頭上輕輕敲了一下，跟以前一模一樣。",
  "speaker": "(unknown / narration or enemy)"
 },
 "菲菲把舊木劍還給師父。師父摸了摸劍尖那圈白布，又替她把鬆掉的布重新纏緊。": {
  "zh": "菲菲把舊木劍還給師父。師父摸了摸劍尖那圈白布，又替她把鬆掉的布重新纏緊。",
  "speaker": "(unknown / narration or enemy)"
 },
 "噹噹把舊木劍交還大俠貓，指了指劍身那片銅：釘子一根都沒鬆。大俠貓點點頭，把劍插回腰間。": {
  "zh": "噹噹把舊木劍交還大俠貓，指了指劍身那片銅：釘子一根都沒鬆。大俠貓點點頭，把劍插回腰間。",
  "speaker": "(unknown / narration or enemy)"
 },
 "封封解下綁在劍鞘旁的舊木劍，交還大俠貓。兩把劍分開時輕輕碰了一聲——這趟貨，送到了。": {
  "zh": "封封解下綁在劍鞘旁的舊木劍，交還大俠貓。兩把劍分開時輕輕碰了一聲——這趟貨，送到了。",
  "speaker": "(unknown / narration or enemy)"
 },
 "{名}把洗乾淨的舊護腕還給{師}。他戴回手上，扣環扣到慣用的那一格，剛剛好。": {
  "zh": "{名}把洗乾淨的舊護腕還給{師}。他戴回手上，扣環扣到慣用的那一格，剛剛好。",
  "speaker": "(unknown / narration or enemy)"
 },
 "{名}解下那只還纏著紫氣的舊護腕。{師}一握住，最後那一絲紫氣也散了。": {
  "zh": "{名}解下那只還纏著紫氣的舊護腕。{師}一握住，最後那一絲紫氣也散了。",
  "speaker": "(unknown / narration or enemy)"
 },
 "{名}把那頂斗笠還給{師}。他接過去看了看，又反手扣回{名}頭上。": {
  "zh": "{名}把那頂斗笠還給{師}。他接過去看了看，又反手扣回{名}頭上。",
  "speaker": "(unknown / narration or enemy)"
 },
 "{名}把那只酒葫蘆遞還給{師}。他搖了搖，裡頭早就空了，還是把葫蘆繫回了腰上。": {
  "zh": "{名}把那只酒葫蘆遞還給{師}。他搖了搖，裡頭早就空了，還是把葫蘆繫回了腰上。",
  "speaker": "(unknown / narration or enemy)"
 },
 "師父替球球重綁手上的繃帶，打了個又大又歪的結。球球愣住了：上次倒在塔裡、醒在村裡時，身上的繃帶也是這種結。": {
  "zh": "師父替球球重綁手上的繃帶，打了個又大又歪的結。球球愣住了：上次倒在塔裡、醒在村裡時，身上的繃帶也是這種結。",
  "speaker": "(unknown / narration or enemy)"
 },
 "師父把菲菲的竹筒撿起來，放在她手邊剛好搆得到的地方。菲菲一愣：上次倒在塔裡、醒在村裡時，竹筒也是這樣放的。": {
  "zh": "師父把菲菲的竹筒撿起來，放在她手邊剛好搆得到的地方。菲菲一愣：上次倒在塔裡、醒在村裡時，竹筒也是這樣放的。",
  "speaker": "(unknown / narration or enemy)"
 },
 "大俠貓替噹噹卸下護臂，把扣帶一條條鬆開放好。噹噹想起上次醒在村裡時，床邊的護臂也是這樣擺的。": {
  "zh": "大俠貓替噹噹卸下護臂，把扣帶一條條鬆開放好。噹噹想起上次醒在村裡時，床邊的護臂也是這樣擺的。",
  "speaker": "(unknown / narration or enemy)"
 },
 "大俠貓把封封的劍和劍鞘並排放好。封封想起上次倒在塔裡、醒在村裡時，床邊的劍也是這樣擺的。": {
  "zh": "大俠貓把封封的劍和劍鞘並排放好。封封想起上次倒在塔裡、醒在村裡時，床邊的劍也是這樣擺的。",
  "speaker": "(unknown / narration or enemy)"
 },
 "師父握住球球的爪子，把手腕往下輕輕壓了半寸，才鬆開。這個角度，球球在塔裡已經練過好多遍了。": {
  "zh": "師父握住球球的爪子，把手腕往下輕輕壓了半寸，才鬆開。這個角度，球球在塔裡已經練過好多遍了。",
  "speaker": "(unknown / narration or enemy)"
 },
 "師父捏起她握針的手，把手腕放低了一點，才鬆開。這個位置，菲菲在塔裡已經練過好多遍。": {
  "zh": "師父捏起她握針的手，把手腕放低了一點，才鬆開。這個位置，菲菲在塔裡已經練過好多遍。",
  "speaker": "(unknown / narration or enemy)"
 },
 "大俠貓伸腳，輕輕踢了踢噹噹的後腳跟。噹噹沒等他開口，就先把腳站開了。": {
  "zh": "大俠貓伸腳，輕輕踢了踢噹噹的後腳跟。噹噹沒等他開口，就先把腳站開了。",
  "speaker": "(unknown / narration or enemy)"
 },
 "大俠貓扶著封封的手，先讓他側過身，再把收劍的方向往身側帶了半寸。劍入鞘，一點聲音都沒有。": {
  "zh": "大俠貓扶著封封的手，先讓他側過身，再把收劍的方向往身側帶了半寸。劍入鞘，一點聲音都沒有。",
  "speaker": "(unknown / narration or enemy)"
 },
 "球球把塔門口撿到的藍布包袱還給師父，借走的那一樣，他拿一條小魚乾補上。師父看了看，把結重新打回又大又歪的樣子。": {
  "zh": "球球把塔門口撿到的藍布包袱還給師父，借走的那一樣，他拿一條小魚乾補上。師父看了看，把結重新打回又大又歪的樣子。",
  "speaker": "(unknown / narration or enemy)"
 },
 "菲菲把藍布包袱捧給師父，小聲說少了一樣是她借的。師父沒有打開，只把那個歪歪的結重新打了一次。": {
  "zh": "菲菲把藍布包袱捧給師父，小聲說少了一樣是她借的。師父沒有打開，只把那個歪歪的結重新打了一次。",
  "speaker": "(unknown / narration or enemy)"
 },
 "噹噹把收好的藍布包袱交給大俠貓，結是他重打的，比原本整齊。大俠貓看了一眼，拆開，又打回原本那個歪結。": {
  "zh": "噹噹把收好的藍布包袱交給大俠貓，結是他重打的，比原本整齊。大俠貓看了一眼，拆開，又打回原本那個歪結。",
  "speaker": "(unknown / narration or enemy)"
 },
 "封封把藍布包袱交還大俠貓，說少的那一樣記在他帳上。大俠貓擺擺手，把包袱往肩上一甩。": {
  "zh": "封封把藍布包袱交還大俠貓，說少的那一樣記在他帳上。大俠貓擺擺手，把包袱往肩上一甩。",
  "speaker": "(unknown / narration or enemy)"
 },
 "吱吱！小魚乾是我們的！": {
  "zh": "吱吱！小魚乾是我們的！",
  "speaker": "(unknown / narration or enemy)"
 },
 "吱吱！這裡是我們的地盤！": {
  "zh": "吱吱！這裡是我們的地盤！",
  "speaker": "(unknown / narration or enemy)"
 },
 "吱！有貓！大家上！": {
  "zh": "吱！有貓！大家上！",
  "speaker": "(unknown / narration or enemy)"
 },
 "（安靜地躺在那裡）": {
  "zh": "（安靜地躺在那裡）",
  "speaker": "(unknown / narration or enemy)"
 },
 "（動也不動，綠得發亮）": {
  "zh": "（動也不動，綠得發亮）",
  "speaker": "(unknown / narration or enemy)"
 },
 "（好像只是一根黃瓜）": {
  "zh": "（好像只是一根黃瓜）",
  "speaker": "(unknown / narration or enemy)"
 },
 "別吃我！": {
  "zh": "別吃我！",
  "speaker": "(unknown / narration or enemy)"
 },
 "我不好吃！真的！": {
  "zh": "我不好吃！真的！",
  "speaker": "(unknown / narration or enemy)"
 },
 "海苔是我的鎧甲！": {
  "zh": "海苔是我的鎧甲！",
  "speaker": "(unknown / narration or enemy)"
 },
 "（木頭味）": {
  "zh": "（木頭味）",
  "speaker": "(unknown / narration or enemy)"
 },
 "（被打過很多次的樣子）": {
  "zh": "（被打過很多次的樣子）",
  "speaker": "(unknown / narration or enemy)"
 },
 "咩？": {
  "zh": "咩？",
  "speaker": "(unknown / narration or enemy)"
 },
 "咩……這裡是哪裡？": {
  "zh": "咩……這裡是哪裡？",
  "speaker": "(unknown / narration or enemy)"
 },
 "咩！別過來！": {
  "zh": "咩！別過來！",
  "speaker": "(unknown / narration or enemy)"
 },
 "嗡————": {
  "zh": "嗡————",
  "speaker": "(unknown / narration or enemy)"
 },
 "嗚嗡——嗡——": {
  "zh": "嗚嗡——嗡——",
  "speaker": "(unknown / narration or enemy)"
 },
 "（把地上的毛全吸走了）": {
  "zh": "（把地上的毛全吸走了）",
  "speaker": "(unknown / narration or enemy)"
 },
 "同行，別擋路。": {
  "zh": "同行，別擋路。",
  "speaker": "(unknown / narration or enemy)"
 },
 "這條路不好走，同行。": {
  "zh": "這條路不好走，同行。",
  "speaker": "(unknown / narration or enemy)"
 },
 "別逼我出手。": {
  "zh": "別逼我出手。",
  "speaker": "(unknown / narration or enemy)"
 },
 "打一場。拿出全力來。": {
  "zh": "打一場。拿出全力來。",
  "speaker": "(unknown / narration or enemy)"
 },
 "點到為止？不，全力。": {
  "zh": "點到為止？不，全力。",
  "speaker": "(unknown / narration or enemy)"
 },
 "讓我看看你有幾分本事。": {
  "zh": "讓我看看你有幾分本事。",
  "speaker": "(unknown / narration or enemy)"
 },
 "（站在白貓旁邊，抱著手）": {
  "zh": "（站在白貓旁邊，抱著手）",
  "speaker": "(unknown / narration or enemy)"
 },
 "師姐說全力，那就全力。": {
  "zh": "師姐說全力，那就全力。",
  "speaker": "(unknown / narration or enemy)"
 },
 "（把手裡劍在指間轉了一圈）": {
  "zh": "（把手裡劍在指間轉了一圈）",
  "speaker": "(unknown / narration or enemy)"
 },
 "留下買路財！": {
  "zh": "留下買路財！",
  "speaker": "(unknown / narration or enemy)"
 },
 "小魚乾全部拿出來！": {
  "zh": "小魚乾全部拿出來！",
  "speaker": "(unknown / narration or enemy)"
 },
 "此路是我開！": {
  "zh": "此路是我開！",
  "speaker": "(unknown / narration or enemy)"
 },
 "嘶——": {
  "zh": "嘶——",
  "speaker": "(unknown / narration or enemy)"
 },
 "嘶嘶——": {
  "zh": "嘶嘶——",
  "speaker": "(unknown / narration or enemy)"
 },
 "（在草叢裡蠕動）": {
  "zh": "（在草叢裡蠕動）",
  "speaker": "(unknown / narration or enemy)"
 },
 "塔主有令，閒貓勿入。": {
  "zh": "塔主有令，閒貓勿入。",
  "speaker": "(unknown / narration or enemy)"
 },
 "止步。塔主不見客。": {
  "zh": "止步。塔主不見客。",
  "speaker": "(unknown / narration or enemy)"
 },
 "（稻草沙沙作響）閒貓勿入。": {
  "zh": "（稻草沙沙作響）閒貓勿入。",
  "speaker": "(unknown / narration or enemy)"
 },
 "我們不講單挑那一套。": {
  "zh": "我們不講單挑那一套。",
  "speaker": "(unknown / narration or enemy)"
 },
 "菜鳥，回去。": {
  "zh": "菜鳥，回去。",
  "speaker": "(unknown / narration or enemy)"
 },
 "想過去，先過我們這關。": {
  "zh": "想過去，先過我們這關。",
  "speaker": "(unknown / narration or enemy)"
 },
 "（比較大根，還是安靜地躺著）": {
  "zh": "（比較大根，還是安靜地躺著）",
  "speaker": "(unknown / narration or enemy)"
 },
 "（真的很大一根）": {
  "zh": "（真的很大一根）",
  "speaker": "(unknown / narration or enemy)"
 },
 "（安靜得可怕）": {
  "zh": "（安靜得可怕）",
  "speaker": "(unknown / narration or enemy)"
 },
 "走到這裡，算你有點本事。": {
  "zh": "走到這裡，算你有點本事。",
  "speaker": "(unknown / narration or enemy)"
 },
 "上面的東西，不是你能碰的。": {
  "zh": "上面的東西，不是你能碰的。",
  "speaker": "(unknown / narration or enemy)"
 },
 "好、好重……": {
  "zh": "好、好重……",
