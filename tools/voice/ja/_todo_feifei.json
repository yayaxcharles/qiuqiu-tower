[
 {
  "zh": "……三天了。師父沒回來，師兄也沒回來。",
  "ctx": [
   "feifei/prologue#2"
  ]
 },
 {
  "zh": "我還是很怕受傷。可是他們要是也在等人幫忙呢？……我得去。",
  "ctx": [
   "feifei/prologue#3"
  ]
 },
 {
  "zh": "是師兄的頭巾。他以前也老是勾破……回去又得替他補了。",
  "ctx": [
   "feifei/actClear1#1"
  ]
 },
 {
  "zh": "師父，您再撐一下……師兄，你到底在哪裡？",
  "ctx": [
   "feifei/actClear2#1"
  ]
 },
 {
  "zh": "我聽見了，師父。我正在上去。",
  "ctx": [
   "feifei/actClear2#3"
  ]
 },
 {
  "zh": "師兄！對、對不起，我來晚了……",
  "ctx": [
   "feifei/topScene#1"
  ]
 },
 {
  "zh": "我不退。……每次叫我退的都是你，受傷的也都是你。",
  "ctx": [
   "feifei/topScene#3"
  ]
 },
 {
  "zh": "師兄，門口交給你。這次……換我先上。",
  "ctx": [
   "feifei/topScene#5"
  ]
 },
 {
  "zh": "還沒……找到他們……",
  "ctx": [
   "feifei/defeat#1"
  ]
 },
 {
  "zh": "傷口好了，我就回去。",
  "ctx": [
   "feifei/defeat#3"
  ]
 },
 {
  "zh": "師父，這又不是切磋……您剛才連我都不認得了。師兄也是，連個消息都沒有。",
  "ctx": [
   "feifei/victory#1"
  ]
 },
 {
  "zh": "我還以為，找不到你們了。",
  "ctx": [
   "feifei/victory#3"
  ]
 },
 {
  "zh": "師父、師兄，明天也一起吃早飯吧。",
  "ctx": [
   "feifei/result:victoryTeaser"
  ]
 },
 {
  "zh": "是師父親手寫的。",
  "ctx": [
   "feifei/secretScroll#1"
  ]
 },
 {
  "zh": "怎麼會留在這裡？他出門時總會帶著的。",
  "ctx": [
   "feifei/secretScroll#2"
  ]
 },
 {
  "zh": "那他現在更需要有人去找他。",
  "ctx": [
   "feifei/afterFirstElite#1"
  ]
 },
 {
  "zh": "明天要過關主守的門，光想就睡不著。",
  "ctx": [
   "feifei/restBeforeBoss1#0"
  ]
 },
 {
  "zh": "藥分好了，針也檢查過了。還漏了什麼嗎？",
  "ctx": [
   "feifei/restBeforeBoss1#1"
  ]
 },
 {
  "zh": "再翻一次只會更清醒……把竹筒放好，睡吧。",
  "ctx": [
   "feifei/restBeforeBoss1#2"
  ]
 },
 {
  "zh": "魔氣這麼重，連呼吸都覺得嗆。",
  "ctx": [
   "feifei/restBeforeBoss2#0"
  ]
 },
 {
  "zh": "剛才那一聲像師父，可我從沒聽他叫得那麼痛。",
  "ctx": [
   "feifei/restBeforeBoss2#1"
  ]
 },
 {
  "zh": "得先過眼前這一關，才走得到他那裡。",
  "ctx": [
   "feifei/restBeforeBoss2#2"
  ]
 },
 {
  "zh": "明天就要見到師父了。我想過好多次，卻不知道見了他該先說什麼。",
  "ctx": [
   "feifei/restBeforeBoss3#0"
  ]
 },
 {
  "zh": "師父第一次教我握針，還特地把尖端轉開，怕我扎到自己。",
  "ctx": [
   "feifei/restBeforeBoss3#1"
  ]
 },
 {
  "zh": "他總記得我怕痛。現在，還會記得嗎？",
  "ctx": [
   "feifei/restBeforeBoss3#2"
  ]
 },
 {
  "zh": "等見了面，我要先叫他一聲。",
  "ctx": [
   "feifei/restBeforeBoss3#3"
  ]
 },
 {
  "zh": "師父，我是菲菲！我站在這裡，您看看我！",
  "ctx": [
   "feifei/bossIntro:tower_master#1"
  ]
 },
 {
  "zh": "退隱也可以回家呀。師兄在門口等著……跟我們回去，好不好？",
  "ctx": [
   "feifei/bossIntro:tower_master#3"
  ]
 },
 {
  "zh": "師父，聽我的聲音。我是您教過握針的那個小徒弟。",
  "ctx": [
   "feifei/bossPhase2:tower_master#1"
  ]
 },
 {
  "zh": "師父，這套招式我認得。您教我的時候，從來不肯真的打下來。",
  "ctx": [
   "feifei/bossPhase3:tower_master#1"
  ]
 },
 {
  "zh": "婆婆，我也想回去。可是家裡少了兩個人，我不能就這樣走。",
  "ctx": [
   "feifei/bossIntro:nekomata#1"
  ]
 },
 {
  "zh": "婆婆剛才還在讓我……這下不能大意。",
  "ctx": [
   "feifei/bossPhase2:nekomata#1"
  ]
 },
 {
  "zh": "還有救……我記住了，不在這裡耽擱。",
  "ctx": [
   "feifei/bossDefeat:nekomata#2"
  ]
 },
 {
  "zh": "這道紫光，跟師父那晚眼裡的一樣。這裡的魔物，都受了魔氣影響。",
  "ctx": [
   "feifei/bossIntro:iron_claw#1"
  ]
 },
 {
  "zh": "爪子這麼密……得看準空隙，別把自己逼到牆角。",
  "ctx": [
   "feifei/bossIntro:iron_claw#2"
  ]
 },
 {
  "zh": "爪子都燒紅了，隔這麼遠還覺得燙。",
  "ctx": [
   "feifei/bossPhase2:iron_claw#1"
  ]
 },
 {
  "zh": "紫光會散，師父也能醒吧？",
  "ctx": [
   "feifei/bossDefeat:iron_claw#1"
  ]
 },
 {
  "zh": "這些是村裡丟的小魚乾嗎？你跟我師父是一夥的？",
  "ctx": [
   "feifei/bossIntro:orange_king#1"
  ]
 },
 {
  "zh": "既然你怕他，為什麼還攔我？那些小魚乾，村裡也還有人等著吃。",
  "ctx": [
   "feifei/bossIntro:orange_king#3"
  ]
 },
 {
  "zh": "樓梯就這麼寬，你捲成球我要躲哪裡！",
  "ctx": [
   "feifei/bossPhase2:orange_king#1"
  ]
 },
 {
  "zh": "別再搶了。",
  "ctx": [
   "feifei/bossDefeat:orange_king#2"
  ]
 },
 {
  "zh": "你說的二當家，是替誰守這裡？",
  "ctx": [
   "feifei/bossIntro:cowcat_boss#1"
  ]
 },
 {
  "zh": "那不是他的本意。他以前從不會叫人這樣守著路。",
  "ctx": [
   "feifei/bossIntro:cowcat_boss#3"
  ]
 },
 {
  "zh": "還有另一套爪法……看清楚，不能照剛才那樣接。",
  "ctx": [
   "feifei/bossPhase2:cowcat_boss#1"
  ]
 },
 {
  "zh": "他以前連罰我蹲馬步都捨不得……您說的，好像是另一個人。",
  "ctx": [
   "feifei/bossDefeat:cowcat_boss#2"
  ]
 },
 {
  "zh": "我不喝，謝謝。師父特別交代過，不能碰您的酒。",
  "ctx": [
   "feifei/bossIntro:tanuki_lord#1"
  ]
 },
 {
  "zh": "變出這麼多隻……哪一隻才是真的啊？",
  "ctx": [
   "feifei/bossPhase2:tanuki_lord#2"
  ]
 },
 {
  "zh": "我會擦乾淨腳再走。塔頂還有人等我，請別攔我。",
  "ctx": [
   "feifei/bossIntro:persian_lady#1"
  ]
 },
 {
  "zh": "我沒有要找你們算帳，別替她擋在前面。",
  "ctx": [
   "feifei/bossPhase2:persian_lady#1"
  ]
 },
 {
  "zh": "借過，我只走池邊，不碰您的東西。",
  "ctx": [
   "feifei/bossIntro:frog_daimyo#1"
  ]
 },
 {
  "zh": "水面都被擠滿了……這麼多，我得顧著兩邊。",
  "ctx": [
   "feifei/bossPhase2:frog_daimyo#1"
  ]
 },
 {
  "zh": "殼上這麼多舊傷……牠也遇過那天的魔氣嗎？",
  "ctx": [
   "feifei/bossIntro:armadillo_king#1"
  ]
 },
 {
  "zh": "我不想碰那些傷口……能讓我從旁邊過嗎？",
  "ctx": [
   "feifei/bossIntro:armadillo_king#2"
  ]
 },
 {
  "zh": "謝謝你讓路。",
  "ctx": [
   "feifei/bossDefeat:armadillo_king#1"
  ]
 },
 {
  "zh": "整條樓梯都被牠壓住了……叫醒牠，一定會生氣吧。",
  "ctx": [
   "feifei/bossIntro:dragon_cat#1"
  ]
 },
 {
  "zh": "是我把您吵醒的。可是路就這一條，我得過去。",
  "ctx": [
   "feifei/bossPhase2:dragon_cat#1"
  ]
 },
 {
  "zh": "我走了，這次不吵你。",
  "ctx": [
   "feifei/bossDefeat:dragon_cat#1"
  ]
 },
 {
  "zh": "我沒想要誰死。可是師父困在上面，我也不能放著他不管。",
  "ctx": [
   "feifei/bossIntro:hex_abbot#1"
  ]
 },
 {
  "zh": "老住持也長出鱗甲了……這還是他原本的樣子嗎？",
  "ctx": [
   "feifei/bossPhase2:hex_abbot#1"
  ]
 },
 {
  "zh": "他連我怕什麼都記得……不會把我全忘了的。我得親口叫叫他。",
  "ctx": [
   "feifei/bossDefeat:hex_abbot#3"
  ]
 },
 {
  "zh": "呼吸穩住。牠的動作跟剛才不同了。",
  "ctx": [
   "feifei/bossPhase2Generic#1"
  ]
 },
 {
  "zh": "還有魔氣……不能在這裡鬆手。",
  "ctx": [
   "feifei/bossPhase3Generic#1"
  ]
 },
 {
  "zh": "那個……借過一下。",
  "ctx": [
   "feifei/bark:battleStart#0"
  ]
 },
 {
  "zh": "針上有毒，別碰。",
  "ctx": [
   "feifei/bark:battleStart#1"
  ]
 },
 {
  "zh": "別追了，前面沒路啦！",
  "ctx": [
   "feifei/bark:battleStart#2"
  ]
 },
 {
  "zh": "袖口綁緊，免得礙手礙腳。",
  "ctx": [
   "feifei/bark:battleStart#3"
  ]
 },
 {
  "zh": "再靠近，我就丟針了。",
  "ctx": [
   "feifei/bark:battleStart#4"
  ]
 },
 {
  "zh": "可以別打臉嗎……拜託。",
  "ctx": [
   "feifei/bark:battleStart#5"
  ]
 },
 {
  "zh": "我不跟你比力氣。",
  "ctx": [
   "feifei/bark:battleStart#6"
  ]
 },
 {
  "zh": "師兄碰上你，會怎麼辦呢？",
  "ctx": [
   "feifei/bark:battleStart#7"
  ]
 },
 {
  "zh": "你一定要守在這裡嗎？",
  "ctx": [
   "feifei/bark:battleStart#8"
  ]
 },
 {
  "zh": "看牠的手，別只顧著怕。",
  "ctx": [
   "feifei/bark:battleStart#9"
  ]
 },
 {
  "zh": "等一下，衣服勾住了！",
  "ctx": [
   "feifei/bark:battleStart#10"
  ]
 },
 {
  "zh": "我只是想把人接回家。",
  "ctx": [
   "feifei/bark:battleStart#11"
  ]
 },
 {
  "zh": "師父教過這個，我記得。",
  "ctx": [
   "feifei/bark:battleStart#12"
  ]
 },
 {
  "zh": "出口在後面，記住了。",
  "ctx": [
   "feifei/bark:battleStart#13"
  ]
 },
 {
  "zh": "不動了……結束了吧？",
  "ctx": [
   "feifei/bark:battleWin#0"
  ]
 },
 {
  "zh": "我有先提醒你喔。",
  "ctx": [
   "feifei/bark:battleWin#1"
  ]
 },
 {
  "zh": "袖子沒破，還好。",
  "ctx": [
   "feifei/bark:battleWin#2"
  ]
 },
 {
  "zh": "呼，終於能喘口氣。",
  "ctx": [
   "feifei/bark:battleWin#3"
  ]
 },
 {
  "zh": "針差點拿不住。",
  "ctx": [
   "feifei/bark:battleWin#4"
  ]
 },
 {
  "zh": "剛才那一下好險。",
  "ctx": [
   "feifei/bark:battleWin#5"
  ]
 },
 {
  "zh": "咦，真的過去了。",
  "ctx": [
   "feifei/bark:battleWin#6"
  ]
 },
 {
  "zh": "借我坐一下，腿軟。",
  "ctx": [
   "feifei/bark:battleWin#7"
  ]
 },
 {
  "zh": "這次沒忘記護住自己。",
  "ctx": [
   "feifei/bark:battleWin#8"
  ]
 },
 {
  "zh": "原來一直緊張也會餓。",
  "ctx": [
   "feifei/bark:battleWin#9"
  ]
 },
 {
  "zh": "沒人聽見我尖叫吧？",
  "ctx": [
   "feifei/bark:battleWin#10"
  ]
 },
 {
  "zh": "手上有藥，不能揉眼睛。",
  "ctx": [
   "feifei/bark:battleWin#11"
  ]
 },
 {
  "zh": "你別再爬起來了，拜託。",
  "ctx": [
   "feifei/bark:battleWin#12"
  ]
 },
 {
  "zh": "針袋還在，沒弄丟。",
  "ctx": [
   "feifei/bark:battleWin#13"
  ]
 },
 {
  "zh": "門口就是來時的路。",
  "ctx": [
   "feifei/bark:battleWin#14"
  ]
 },
 {
  "zh": "舌頭咬到了，嗚。",
  "ctx": [
   "feifei/bark:battleWin#15"
  ]
 },
 {
  "zh": "餓得使不上力了。",
  "ctx": [
   "feifei/bark:hungry#0"
  ]
 },
 {
  "zh": "飯糰……沒有了。",
  "ctx": [
   "feifei/bark:hungry#1"
  ]
 },
 {
  "zh": "現在給我白飯也好，真的。",
  "ctx": [
   "feifei/bark:hungry#2"
  ]
 },
 {
  "zh": "那個……剛才是肚子叫。",
  "ctx": [
   "feifei/bark:hungry#3"
  ]
 },
 {
  "zh": "先別講吃的，我受不了。",
  "ctx": [
   "feifei/bark:hungry#4"
  ]
 },
 {
  "zh": "回家我要先盛一大碗。",
  "ctx": [
   "feifei/bark:hungry#5"
  ]
 },
 {
  "zh": "不要碰傷口！",
  "ctx": [
   "feifei/bark:lowHp#0"
  ]
 },
 {
  "zh": "不行，我還不能倒……",
  "ctx": [
   "feifei/bark:lowHp#1"
  ]
 },
 {
  "zh": "血止不住，怎麼辦……",
  "ctx": [
   "feifei/bark:lowHp#2"
  ]
 },
 {
  "zh": "繃帶快不夠了。",
  "ctx": [
   "feifei/bark:lowHp#3"
  ]
 },
 {
  "zh": "握緊，還不能鬆手。",
  "ctx": [
   "feifei/bark:lowHp#4"
  ]
 },
 {
  "zh": "我還得帶他們回家……",
  "ctx": [
   "feifei/bark:lowHp#5"
  ]
 },
 {
  "zh": "箱蓋下面沒夾東西吧？",
  "ctx": [
   "feifei/bark:chest#0"
  ]
 },
 {
  "zh": "我敲一下，你別突然跳出來。",
  "ctx": [
   "feifei/bark:chest#1"
  ]
 },
 {
  "zh": "空的嗎？我掀開囉。",
  "ctx": [
   "feifei/bark:chest#2"
  ]
 },
 {
  "zh": "從這邊打開，才不會夾到尾巴。",
  "ctx": [
   "feifei/bark:chest#3"
  ]
 },
 {
  "zh": "有乾淨繃帶就好了。",
  "ctx": [
   "feifei/bark:chest#4"
  ]
 },
 {
  "zh": "這個紙箱有人要嗎？",
  "ctx": [
   "feifei/bark:chest#5"
  ]
 },
 {
  "zh": "家裡也有個這樣的紙箱。",
  "ctx": [
   "feifei/bark:chest#6"
  ]
 },
 {
  "zh": "師兄倒是很會找地方睡。",
  "ctx": [
   "feifei/bark:chest#7"
  ]
 },
 {
  "zh": "唔……還以為回到家了。",
  "ctx": [
   "feifei/bark:restNap#0"
  ]
 },
 {
  "zh": "外面還是很安靜。",
  "ctx": [
   "feifei/bark:restNap#1"
  ]
 },
 {
  "zh": "好久沒睡得這麼沉了。",
  "ctx": [
   "feifei/bark:restNap#2"
  ]
 },
 {
  "zh": "眼睛舒服多了，剛才好澀。",
  "ctx": [
   "feifei/bark:restNap#3"
  ]
 },
 {
  "zh": "被子好暖，捨不得掀開。",
  "ctx": [
   "feifei/bark:restNap#4"
  ]
 },
 {
  "zh": "夢還沒做完，就醒了。",
  "ctx": [
   "feifei/bark:restNap#5"
  ]
 },
 {
  "zh": "尾巴睡麻了……讓我伸一下。",
  "ctx": [
   "feifei/bark:restNap#6"
  ]
 },
 {
  "zh": "香、香爐的煙一直往鼻子鑽……我一整晚都沒闔眼，對不起……",
  "ctx": [
   "feifei/bark:restNapRestless#0"
  ]
 },
 {
  "zh": "這根的毛邊總算磨掉了。",
  "ctx": [
   "feifei/bark:restSharpen#0"
  ]
 },
 {
  "zh": "這樣拿，出手就不會卡住。",
  "ctx": [
   "feifei/bark:restSharpen#1"
  ]
 },
 {
  "zh": "針尖沾好藥，握的地方也擦乾淨了。",
  "ctx": [
   "feifei/bark:restSharpen#2"
  ]
 },
 {
  "zh": "磨好了，心裡踏實些。",
  "ctx": [
   "feifei/bark:restSharpen#3"
  ]
 },
 {
  "zh": "彎的挑出來了，這些都能用。",
  "ctx": [
   "feifei/bark:restSharpen#4"
  ]
 },
 {
  "zh": "這個角度，終於對了。",
  "ctx": [
   "feifei/bark:restSharpen#5"
  ]
 },
 {
  "zh": "下次手別抖就好了。",
  "ctx": [
   "feifei/bark:restSharpen#6"
  ]
 },
 {
  "zh": "太好了……你還在。",
  "ctx": [
   "feifei/bark:revive#0"
  ]
 },
 {
  "zh": "先坐一下，我扶著你。",
  "ctx": [
   "feifei/bark:revive#1"
  ]
 },
 {
