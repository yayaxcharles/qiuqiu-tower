[
 {
  "zh": "難逢敵手。",
  "ja": "好敵手、得難し。",
  "tts": "こうてきしゅ、えがたし。"
 },
 {
  "zh": "深藏不露。",
  "ja": "能ある鷹は爪を隠す。",
  "tts": "のうあるたかは、つめをかくす。"
 },
 {
  "zh": "在下不才。",
  "ja": "拙者、未熟なり。",
  "tts": "せっしゃ、みじゅくなり。"
 },
 {
  "zh": "承讓。",
  "ja": "お見事。",
  "tts": "おみごと。"
 },
 {
  "zh": "退隱江湖。",
  "ja": "世を捨てた身。",
  "tts": "よをすてたみ。"
 },
 {
  "zh": "走火入魔。",
  "ja": "魔道に堕ちたり。",
  "tts": "まどうに、おちたり。"
 }
