   "dangdang/firstMeet:plated_beetle"
  ]
 },
 {
  "zh": "前面排得整整齊齊，後面還有人指揮。",
  "ctx": [
   "dangdang/firstMeet:rat_general"
  ]
 },
 {
  "zh": "槍尖別亂晃，眼睛差點被你戳到。",
  "ctx": [
   "dangdang/firstMeet:rat_guard"
  ]
 },
 {
  "zh": "你嘴裡在唸什麼？聽了就不舒服。",
